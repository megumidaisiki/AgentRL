# Large files live only in /workspace on RunPod, never in Git
models/
data/
checkpoints/
ckpts/
wandb/
*.parquet
*.safetensors
*.bin
*.pt
*.pth

# Secrets
.env
.env.*
*.pem
*token*

# Python and OS files
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db

# Local Claude Code settings
.claude/settings.local.json

# Archives copied back from the Pod; extracted logs go under results/
*.tar.gz
# Full validation responses saved during training are too large; kept locally only
results/*/val_generations/gsm8k-*/
# Thinking-mode GSM8K evaluation responses (~23 MB); kept locally only
results/*/val_generations/eval-gsm8k-*-think/
